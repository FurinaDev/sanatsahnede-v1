# ==============================================================================
# SanatSahnede — Çevre Değişkenleri (Örnek Yapılandırma)
# Gerçek üretim anahtarlarını .env dosyasına koyun; asla Git'e commit etmeyin.
# ==============================================================================

# Sunucu & Oturum Güvenliği
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-secret-in-production
DATABASE_PATH=./data/sanatsahnede.db

# Sandbox / Demo Davranışı (Production ortamında false yapın)
ENABLE_DEMO_QUICK_LOGIN=true

# Ödeme Sağlayıcı — iyzico Marketplace (Anahtar yoksa Sandbox adaptörü çalışır)
PAYMENT_MODE=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_WEBHOOK_SECRET=

# Harita Sağlayıcı — Google Maps / Mapbox (Anahtar yoksa dahili Türkiye şehir haritası çalışır)
VITE_GOOGLE_MAPS_API_KEY=

# E-posta & SMS Doğrulama Sağlayıcıları (Anahtar yoksa sandbox doğrulama kodu döner)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sanatsahnede.com
SMS_PROVIDER_API_KEY=

# Harici Kimlik Doğrulama Sağlayıcısı (Opsiyonel — e-Devlet şifresi asla istenmez)
KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=

# Yapay Zekâ Yardımcıları (Sunucu tarafı Gemini API)
GEMINI_API_KEY=
